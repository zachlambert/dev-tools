USERNAME=$USERNAME
LOCAL_WORKSPACE=$HOME/ros2_ws
UID=1000
GID=1000
ROS_DOMAIN_ID=172 # Something unique to isolate from other ROS running on common network
RMW_IMPLEMENTATION=rmw_fastrtps_cpp # rmw_cyclonedds_cpp rmw_fastrtps_cpp
DOCKER_TAG=latest
REGISTRY=docker.op.vaarst.io/beam/ # Optional. If provided, the poseidon containers will pull from this registry
