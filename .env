USERNAME=$USERNAME
LOCAL_WORKSPACE=$HOME/ros2_ws
UID=1000
GID=1000
ROS_DOMAIN_ID=172 # Something unique to isolate from other ROS running on common network
RMW_IMPLEMENTATION=rmw_fastrtps_cpp # rmw_cyclonedds_cpp rmw_fastrtps_cpp
DOCKER_TAG=latest
REGISTRY=docker.op.vaarst.io/beam/ # Optional. If provided, the poseidon containers will pull from this registry
# Unreal simulator specific tags
SIM_TAG=657eaf5b79fa8b748645132202da67e77df39e5b # git tag version of the simulator images 
VSIM_TAG=5bd734cd3cf6e066c3e71a031a666cab6bc79ab3 # git tag version of the VSimCLI external repo
INTERFACES_TAG=e9adc1f0c19a99ef4148bc19c12e3db03fe547a2 # git tag version of the interfaces external repo
